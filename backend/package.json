{
  "name": "peer-eval-backend",
  "version": "1.0.0",
  "description": "Backend for peer evaluation system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:set-provider": "node prisma/set-provider.js",
    "db:push": "npm run db:set-provider && prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:generate": "npm run db:set-provider && prisma generate",
    "postinstall": "npm run db:generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@node-saml/passport-saml": "^4.0.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.2",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "pg": "^8.16.3",
    "prisma": "^5.22.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
